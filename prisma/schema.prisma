// OrderFlow OS — modelo de dados
// Todos os valores monetários são armazenados em CENTAVOS (Int) para evitar erros de ponto flutuante.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  OPERATOR
}

enum OrderType {
  DELIVERY
  PICKUP
  TABLE
}

enum OrderStatus {
  PENDING          // Aguardando aceite
  PREPARING        // Em preparo
  OUT_FOR_DELIVERY // Saiu para entrega / Pronto (balcão e mesa)
  COMPLETED        // Concluído
  CANCELED
}

enum PaymentMethod {
  PIX
  CARD
  CASH
  ON_SITE // Pedido na mesa: pago presencialmente no caixa antes de sair
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERATOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  sortOrder  Int       @default(0)
  // Permite pizza 1/2 a 1/2 entre produtos desta categoria
  allowsHalf Boolean   @default(false)
  // Tipo do produto no singular, exibido antes do nome: "Esfiha" Calabresa, "Pizza" Baiana...
  itemLabel  String?
  active     Boolean   @default(true)
  products   Product[]
  addons     Addon[]
}

model Product {
  id          String           @id @default(cuid())
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  // Preço base em centavos — usado quando o produto não tem variações (tamanhos)
  price       Int              @default(0)
  active      Boolean          @default(true)
  sortOrder   Int              @default(0)
  variants    ProductVariant[]
  orderItems  OrderItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId, active])
}

// Tamanhos (ex: Grande | Broto). O nome é a chave usada para casar sabores no 1/2 a 1/2.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Int
  sortOrder Int     @default(0)

  @@unique([productId, name])
}

// Acréscimos disponíveis para todos os produtos de uma categoria
model Addon {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  name       String
  price      Int
  active     Boolean  @default(true)

  @@unique([categoryId, name])
}

model Driver {
  id        String   @id @default(cuid())
  name      String
  phone     String
  active    Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id                String        @id @default(cuid())
  number            Int           @unique @default(autoincrement())
  // Token aleatório (não sequencial) do link "Acompanhe seu pedido" enviado ao cliente
  trackingToken     String        @unique
  type              OrderType
  status            OrderStatus   @default(PENDING)
  customerName      String
  customerPhone     String
  tableNumber       Int?
  addressStreet     String?
  addressNumber     String?
  addressDistrict   String?
  addressComplement String?
  addressReference  String?
  addressZip        String? // CEP (só dígitos)
  paymentMethod     PaymentMethod
  changeFor         Int?
  subtotal          Int
  // null = taxa de entrega ainda não definida pelo operador
  deliveryFee       Int?
  total             Int
  notes             String?
  // Pedido lançado pela loja no portal (nome de quem lançou); null = feito pelo cliente
  createdBy         String?
  // Cupom aplicado no pedido (código) e o desconto concedido em centavos
  couponCode        String?
  discount          Int           @default(0)
  // Cliente aceitou receber atualizações automáticas no WhatsApp (opt-in explícito)
  whatsappUpdates   Boolean       @default(false)
  waAcceptedAt      DateTime? // aviso "pedido aceito" enviado
  waDispatchedAt    DateTime? // aviso "saiu para entrega" / "pronto para retirada" enviado
  waError           String? // último erro de envio (mostrado no painel)
  driverId          String?
  driver            Driver?       @relation(fields: [driverId], references: [id])
  // Cliente cadastrado que fez o pedido (null = pedido sem cadastro)
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  // Comanda da mesa: pedidos da mesma mesa somam numa conta até a loja fechar
  tableSessionId    String?
  tableSession      TableSession? @relation(fields: [tableSessionId], references: [id])
  items             OrderItem[]
  rating            OrderRating?
  acceptedAt        DateTime?
  dispatchedAt      DateTime?
  completedAt       DateTime?
  canceledAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Snapshot dos nomes/preços no momento da compra: alterações futuras no cardápio não afetam pedidos antigos.
model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  productName     String
  halfProductId   String?
  halfProductName String?
  // Snapshot do tipo do produto (Esfiha, Pizza, Pastel...) no momento da compra
  categoryLabel   String?
  variantName     String?
  // [{ "name": "Catupiry", "price": 400 }]
  addons          Json    @default("[]")
  unitPrice       Int
  quantity        Int
  totalPrice      Int
  notes           String?

  @@index([orderId])
}

model StoreSettings {
  id              Int      @id @default(1)
  storeName       String
  isOpen          Boolean  @default(true)
  pixKey          String?
  pixMerchantName String?
  pixMerchantCity String?
  // Nome do titular exibido ao cliente (com acentos), ex: "Maria Brandão / A Mega Esfiha"
  pixHolderName   String?
  whatsappNumber  String?
  instagram       String? // usuário do Instagram, sem @
  updatedAt       DateTime @updatedAt
}

// Mesas do salão. O QR Code de cada mesa leva o número + o token; pedido na mesa só é aceito
// com o token correto (impede pedir "na mesa" sem estar na loja). Gerar novo token invalida o QR antigo.
model DiningTable {
  number    Int      @id
  token     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bairros atendidos no delivery e a taxa de cada um (em centavos).
// No checkout o cliente escolhe o bairro e a taxa entra automaticamente; bairro fora da lista = taxa a definir.
model DeliveryZone {
  id        String   @id @default(cuid())
  name      String   @unique
  fee       Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cliente com cadastro: entra com WhatsApp + senha de 4 dígitos e já encontra nome e endereço salvos.
model Customer {
  id                String    @id @default(cuid())
  name              String
  phone             String    @unique // só dígitos, com DDD (ex: 11912345678)
  email             String? // opcional: recebe a confirmação do cadastro por e-mail
  pinHash           String
  addressStreet     String?
  addressNumber     String?
  addressDistrict   String?
  addressComplement String?
  addressReference  String?
  addressZip        String? // CEP (só dígitos)
  zoneId            String? // bairro da lista de taxas, quando escolhido
  orders            Order[]
  lastOrderAt       DateTime?
  // Boas-vindas do cadastro: quando foi enviada (ou o erro), por WhatsApp e por e-mail
  welcomeWaAt       DateTime?
  welcomeEmailAt    DateTime?
  welcomeError      String?
  // Aceitou receber cupons e promoções no WhatsApp (consentimento LGPD, art. 7º, I)
  marketingOptIn    Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Comanda (conta) de uma mesa: aberta no primeiro pedido, fechada pela loja ao receber o pagamento.
// Depois de fechada, o próximo pedido daquela mesa abre uma comanda nova (zerada).
model TableSession {
  id          String         @id @default(cuid())
  tableNumber Int
  openedAt    DateTime       @default(now())
  closedAt    DateTime?
  closedBy    String? // nome de quem fechou
  paidWith    PaymentMethod? // como foi pago no caixa
  total       Int? // total cobrado no fechamento, já com desconto (centavos)
  discount    Int            @default(0) // desconto da Mesa Premiada aplicado no fechamento
  orders      Order[]
  mesaPremiada MesaPremiada?

  @@index([tableNumber, closedAt])
}

// Campanha "Mesa Premiada - Edição de Natal" (linha única de configuração).
model CampanhaNatal {
  id        Int      @id @default(1)
  name      String   @default("Mesa Premiada - Edição de Natal")
  active    Boolean  @default(true)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  weekdays  Int[] // dias ativos: 0=domingo ... 6=sábado
  discount  Int      @default(5000) // centavos; conta menor ou igual sai de graça
  // Só participam do sorteio as mesas desta faixa (inclusive)
  minTable  Int      @default(1)
  maxTable  Int      @default(26)
  // Horário do sorteio nos dias de evento, em minutos desde a meia-noite (Brasília): 18:00 às 22:30
  drawStartMinute Int @default(1080)
  drawEndMinute   Int @default(1350)
  updatedAt DateTime @updatedAt
}

// Mesa sorteada de cada dia da campanha (uma por dia). Fica só no servidor: o cliente
// não tem como descobrir a mesa premiada antes do pagamento no caixa.
model MesaPremiada {
  id              String        @id @default(cuid())
  date            DateTime      @unique @db.Date // dia do evento (horário de Brasília)
  tableNumber     Int
  tableSessionId  String?       @unique // comanda sorteada
  tableSession    TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  trigger         String // "AUTO" (sistema, no horário da campanha), "MANUAL" (botão Sortear) ou "FIRST_PAYMENT" (versão antiga)
  drawnBy         String?
  drawnAt         DateTime      @default(now())
  awarded         Boolean       @default(false) // desconto já aplicado no caixa
  originalTotal   Int?
  discountApplied Int?
  redeemedAt      DateTime?
}

// Cliente na mesa apertou "Chamar atendente" (ou "Pedir a conta"). Fica pendente até a equipe atender.
model TableCall {
  id          String    @id @default(cuid())
  tableNumber Int
  reason      String // "ATENDIMENTO" ou "CONTA"
  createdAt   DateTime  @default(now())
  attendedAt  DateTime?
  attendedBy  String?

  @@index([attendedAt])
  @@index([tableNumber, attendedAt])
}

// ======================= WhatsApp (robô da loja) =======================

// Sessão do WhatsApp conectado pelo QR Code (credenciais e chaves de criptografia do protocolo),
// guardada cifrada (AES-256-GCM). Assim o robô volta sozinho depois de reinícios e publicações.
model WaAuth {
  id        String   @id
  data      String
  updatedAt DateTime @updatedAt
}

// Configuração do robô e das automações (linha única).
model WaConfig {
  id                 Int       @id @default(1)
  enabled            Boolean   @default(true)  // envio automático ligado
  ratingEnabled      Boolean   @default(true)
  ratingDelayHours   Int       @default(24)
  couponEnabled      Boolean   @default(true)
  couponDelayDays    Int       @default(7)
  couponPercent      Int       @default(10)
  couponValidityDays Int       @default(15)
  couponPrefix       String    @default("VOLTE")
  couponMinOrder     Int       @default(0)
  deliveryEta        String    @default("40 a 60 minutos")
  minIntervalSeconds Int       @default(4)    // pausa mínima entre mensagens (anti-bloqueio)
  maxPerHour         Int       @default(150)
  // Qual servidor está com o robô ligado (evita duas conexões ao mesmo tempo durante uma publicação)
  leaseOwner         String?
  leaseUntil         DateTime?
  connectedPhone     String?
  connectedName      String?
  connectedAt        DateTime?
  lastSyncAt         DateTime?
  updatedAt          DateTime  @updatedAt
}

// Texto de cada mensagem automática, editável no portal ({{nome}}, {{pedido}}, {{valor}}, {{link}}...).
model WaTemplate {
  key       String   @id
  body      String
  active    Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

enum WaMessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELED
}

// Fila e histórico de todas as mensagens. dedupeKey única: a mesma mensagem nunca sai duas vezes.
model WaMessage {
  id          String          @id @default(cuid())
  dedupeKey   String          @unique
  kind        String // STATUS, RATING, COUPON, CAMPAIGN, MANUAL, REPLY
  templateKey String?
  vars        Json            @default("{}")
  phone       String // só dígitos, com DDD (sem o 55)
  body        String?         // texto final (preenchido no envio)
  status      WaMessageStatus @default(QUEUED)
  attempts    Int             @default(0)
  error       String?
  providerId  String?
  provider    String?
  orderId     String?
  campaignId  String?
  createdBy   String?
  notBefore   DateTime        @default(now())
  createdAt   DateTime        @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?

  @@index([status, notBefore])
  @@index([phone])
  @@index([createdAt])
  @@index([providerId])
  @@index([campaignId])
}

// Registro de eventos do robô: conexão, desconexão, QR Code, erros, respostas de clientes.
model WaEvent {
  id        String   @id @default(cuid())
  kind      String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Contato do WhatsApp (qualquer cliente que pediu com telefone): consentimento e descadastro.
model WaContact {
  phone          String    @id // só dígitos, com DDD
  name           String?
  jid            String?   // endereço real no WhatsApp (resolve o 9º dígito)
  marketingOptIn Boolean   @default(false)
  optInAt        DateTime?
  optOutAt       DateTime? // respondeu SAIR: não recebe mais nada automático
  lastContactAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Campanha de mensagens para clientes que aceitaram promoções.
model WaCampaign {
  id           String    @id @default(cuid())
  name         String
  body         String
  audience     String // OPTIN_ALL, INACTIVE, VIP
  inactiveDays Int?
  couponCode   String?
  status       String    @default("DRAFT") // DRAFT, SENDING, DONE, CANCELED
  total        Int       @default(0)
  createdBy    String?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
}

// Cupom de desconto: geral (código para todos) ou pessoal (só para um WhatsApp).
model Coupon {
  code       String   @id
  kind       String // PERCENT ou FIXED
  value      Int // % (PERCENT) ou centavos (FIXED)
  minOrder   Int      @default(0)
  validUntil DateTime
  maxUses    Int      @default(1)
  usedCount  Int      @default(0)
  phone      String? // cupom pessoal
  active     Boolean  @default(true)
  source     String   @default("MANUAL") // MANUAL, COMEBACK, CAMPAIGN
  createdAt  DateTime @default(now())
}

// Avaliação do pedido (link do acompanhamento ou resposta 1 a 5 no WhatsApp).
model OrderRating {
  orderId   String   @id
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stars     Int
  comment   String?
  source    String // LINK ou WHATSAPP
  createdAt DateTime @default(now())
}
