# Banco de dados (docker-compose sobe um Postgres com essas credenciais)
DATABASE_URL="postgresql://orderflow:orderflow@localhost:5432/orderflow?schema=public"

# Segredo do JWT: no mínimo 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-com-pelo-menos-32-chars"

# Servidor
PORT=3000
APP_HOST=localhost
# true somente se estiver atrás de um proxy reverso confiável (nginx, Cloudflare...)
TRUST_PROXY=false
# Origem pública da aplicação (usada na checagem anti-CSRF). Vazio = usa o header Host.
APP_ORIGIN=

# Usuário gerente criado pelo seed (senha com 12+ caracteres)
SEED_ADMIN_NAME="Gerente"
SEED_ADMIN_EMAIL="gerente@orderflow.local"
SEED_ADMIN_PASSWORD=""

# Configurações da loja aplicadas no seed
SEED_STORE_NAME="OrderFlow Esfiharia & Pizzaria"
# Chave telefone no formato oficial: +55 + DDD + número, ex: "+5511999998888"
SEED_PIX_KEY=""
SEED_PIX_MERCHANT_NAME="ORDERFLOW"
SEED_PIX_MERCHANT_CITY="SAO PAULO"
# Nome do titular exibido ao cliente na tela de pagamento
SEED_PIX_HOLDER_NAME=""
# Somente dígitos com DDI, ex: 5511999998888
SEED_WHATSAPP_NUMBER=""

# Mesas: quantidade criada pelo seed (cada mesa ganha um QR Code com chave própria)
TABLE_COUNT=50

# WhatsApp automático (API oficial do WhatsApp Business / Meta Cloud API).
# Sem estas variáveis o envio automático fica desligado (o botão manual do painel continua).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_ACCEPTED=pedido_aceito
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=pedido_saiu_entrega
WHATSAPP_TEMPLATE_READY_PICKUP=pedido_pronto_retirada
WHATSAPP_TEMPLATE_LANG=pt_BR

# Painel de Chamada de Senhas (TV da loja): quando um pedido de retirada fica pronto, o portal chama
# sozinho o número e o primeiro nome do cliente. Sem estas variáveis, a chamada automática fica desligada.
CALL_PANEL_URL=
CALL_PANEL_USER=
CALL_PANEL_PASSWORD=
CALL_PANEL_PLACE=Balcão
